[sub_resource type="Resource" id="pushbox"]
script = ExtResource("box")
offset = Vector2(0, -80)
size = Vector2(64, 160)

[sub_resource type="Resource" id="hurtbox"]
script = ExtResource("box")
offset = Vector2(0, -82)
size = Vector2(72, 164)

[sub_resource type="Resource" id="override_super_heavy"]
script = ExtResource("override")
canonical_move_id = &"stand_heavy"
replacement_move_id = &"doge_super_heavy"

[sub_resource type="Resource" id="mode_super_doge"]
script = ExtResource("mode")
mode_id = &"super_doge"
duration_frames = 480
move_overrides = Array[ExtResource("override")]([SubResource("override_super_heavy")])

[sub_resource type="Resource" id="mechanics"]
script = ExtResource("mech")
modes = Array[ExtResource("mode")]([SubResource("mode_super_doge")])

[resource]
script = ExtResource("char")
