[gd_resource type="Resource" load_steps=20 format=3]

[ext_resource type="Script" path="res://data/character_data.gd" id="char"]
[ext_resource type="Script" path="res://data/box_data.gd" id="box"]
[ext_resource type="Script" path="res://data/mechanics/character_mechanics_data.gd" id="mech"]
[ext_resource type="Script" path="res://data/mechanics/fighter_resource_data.gd" id="res"]
[ext_resource type="Script" path="res://data/mechanics/status_effect_data.gd" id="status"]
[ext_resource type="Script" path="res://data/mechanics/mode_data.gd" id="mode"]
[ext_resource type="Script" path="res://data/mechanics/mode_move_override_data.gd" id="override"]
[ext_resource type="Script" path="res://data/mechanics/defense_modifier_data.gd" id="defense"]
[ext_resource type="Resource" path="res://data/move_sets/roster/pink_star_move_set.tres" id="moveset"]

[sub_resource type="Resource" id="box_1"]
script = ExtResource("box")
offset = Vector2(0, -80)
size = Vector2(64, 160)

[sub_resource type="Resource" id="box_2"]
script = ExtResource("box")
offset = Vector2(0, -82)
size = Vector2(72, 164)

[sub_resource type="Resource" id="res_1"]
script = ExtResource("res")
resource_id = &"face_actions"
min_value = 0
max_value = 5
round_start_value = 0
display_to_hud = true

[sub_resource type="Resource" id="override_1"]
script = ExtResource("override")
canonical_move_id = &"stand_light"
replacement_move_id = &"pink_true_light"

[sub_resource type="Resource" id="override_2"]
script = ExtResource("override")
canonical_move_id = &"stand_heavy"
replacement_move_id = &"pink_true_heavy"

[sub_resource type="Resource" id="override_3"]
script = ExtResource("override")
canonical_move_id = &"crouch_low"
replacement_move_id = &"pink_true_low"

[sub_resource type="Resource" id="override_4"]
script = ExtResource("override")
canonical_move_id = &"air_attack"
replacement_move_id = &"pink_true_air"

[sub_resource type="Resource" id="override_5"]
script = ExtResource("override")
canonical_move_id = &"special_neutral"
replacement_move_id = &"pink_true_special"

[sub_resource type="Resource" id="mode_1"]
script = ExtResource("mode")
mode_id = &"true_face"
duration_frames = 0
dash_speed_permille = 1300
move_overrides = Array[ExtResource("override")]([SubResource("override_1"), SubResource("override_2"), SubResource("override_3"), SubResource("override_4"), SubResource("override_5")])
exit_when_resource_zero_id = &"face_actions"
exit_recovery_frames = 24
exit_move_id = &"true_face_exit"
finisher_enabled = false

[sub_resource type="Resource" id="mech_1"]
script = ExtResource("mech")
resources = Array[ExtResource("res")]([SubResource("res_1")])
modes = Array[ExtResource("mode")]([SubResource("mode_1")])

[resource]
script = ExtResource("char")
id = &"pink_star"
display_name = "粉紅星星"
max_hp = 5000
max_meter = 100
walk_forward_units_per_tick = 290
walk_back_units_per_tick = 245
jump_velocity_y_units_per_tick = -1400
gravity_y_units_per_tick2 = 80
max_fall_speed_y_units_per_tick = 1800
air_forward_units_per_tick = 230
air_back_units_per_tick = 210
landing_recovery_frames = 3
dash_move_frames = 8
dash_speed_units_per_tick = 890
dash_recovery_frames = 4
backstep_move_frames = 7
backstep_speed_units_per_tick = 800
backstep_recovery_frames = 6
default_getup_frames = 18
pushbox = SubResource("box_1")
hurtbox = SubResource("box_2")
move_set = ExtResource("moveset")
mechanics = SubResource("mech_1")
